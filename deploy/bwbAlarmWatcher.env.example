# Copy to /opt/BwbAlarmWatcher/bwbAlarmWatcher.env
#   sudo chown bwbalarmwatcher: /opt/BwbAlarmWatcher/bwbAlarmWatcher.env
#   sudo chmod 600 /opt/BwbAlarmWatcher/bwbAlarmWatcher.env
#
# Every setting from appsettings.json can be overridden here using the
# Section__Key notation.

# --- Required ---------------------------------------------------------------
# Long-lived bearer token (api:alarm:read, restricted to the Kempten unit).
Api__AuthToken=CHANGE_ME

# Static IP of the LG TV in the station WLAN (ping sensor).
Tv__IpAddress=192.168.0.100

# --- Optional overrides -----------------------------------------------------
# GraphQL endpoint. Default is the services environment (same as v1 production).
# For the sandbox environment use:
#Api__GraphQlUrl=https://api.sandbox.bergwacht-bayern.org/graphql

# Query window in seconds (default 3600 = 1 h). Up to 30 days for testing
# against historical alarms:
#Api__LookbackSec=2592000

# Verified "closed" subkind values, once checked against the live API
# (documentation is inconsistent: NEW/UPDATE/CLOSED vs. OPEN):
#Api__ClosedSubkinds__0=CLOSED

# Page size of the alarms query (max 250); a warning is logged when it overflows:
#Api__Limit=100

# Alarm filters (same keys as v1). Blocked wins over allowed; default blocks "ECH":
#Alarm__UseManualAlarms=true
#Alarm__MessageBlockedParts__0=ECH
#Alarm__MessageAllowedParts__0=Kempten

#Worker__PollingIntervalInSec=15
#Worker__AutoOffAfterSec=1800
