{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "System.Net.Http.HttpClient": "Warning",
      "Polly": "Warning"
    }
  },
  "Worker": {
    "PollingIntervalInSec": 15,
    "AutoOffAfterSec": 1800
  },
  "Api": {
    "AuthToken": "AuthTokenSpacer",
    "GraphQlUrl": "https://api.services.bergwacht-bayern.org/graphql",
    "LookbackSec": 3600,
    "Limit": 100,
    "ClosedSubkinds": ["CLOSED"]
  },
  "Alarm": {
    "UseManualAlarms": true,
    "MessageBlockedParts": ["ECH"],
    "MessageAllowedParts": []
  },
  "Tv": {
    "IpAddress": "127.0.0.1",
    "PingTimeoutMs": 2000,
    "PingAttempts": 3,
    "PingRetryDelayMs": 250,
    "CecClientPath": "cec-client",
    "CecTvAddress": 0,
    "CecCommandTimeoutSec": 20,
    "CecSetActiveSourceAfterOn": true
  }
}
