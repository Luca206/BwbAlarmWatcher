# /etc/systemd/system/bwbAlarmWatcher.service
#
# Install:
#   sudo cp bwbAlarmWatcher.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now bwbAlarmWatcher.service
# Logs:
#   journalctl -u bwbAlarmWatcher.service -f

[Unit]
Description=BwbAlarmWatcher - Bergwacht Kempten Alarmmonitor TV-Steuerung
Wants=network-online.target
After=network-online.target

[Service]
# Type=notify + WatchdogSec: the host signals readiness and pings the systemd
# watchdog; if the process ever hangs, systemd kills and restarts it.
Type=notify
WatchdogSec=60
Restart=always
RestartSec=5

# Dedicated system user; member of "video" so cec-client can access /dev/cec0:
#   sudo useradd --system --no-create-home --groups video bwbalarmwatcher
User=bwbalarmwatcher
Group=bwbalarmwatcher

WorkingDirectory=/opt/BwbAlarmWatcher
ExecStart=/opt/BwbAlarmWatcher/BwbAlarmWatcher
# Contains Api__AuthToken and Tv__IpAddress (mode 600, owner bwbalarmwatcher).
EnvironmentFile=/opt/BwbAlarmWatcher/bwbAlarmWatcher.env

# Hardening (kept compatible with cec-client and ICMP ping)
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
